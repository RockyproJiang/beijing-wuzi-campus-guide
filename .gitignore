# 依赖
node_modules/

# 环境变量（真实数据库密码 / JWT 密钥，绝不入库）
.env
.env.*
!.env.example

# 运行产物与日志
app/logs/*
app/server/backups/*
!app/server/backups/.gitkeep
*.log

# 用户上传的照片（只保留目录结构）
app/public/uploads/album/*
!app/public/uploads/album/.gitkeep
app/public/uploads/submissions/*
!app/public/uploads/submissions/.gitkeep

# Blender 备份文件（保留主模型与脚本）
blender/*.blend1
blender/*.blend2
blender/*备份*.blend

# 系统与编辑器
.DS_Store
Thumbs.db
__pycache__/
*.pyc
