{
  "name": "bwz-campus-guide",
  "version": "1.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c green,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "start": "cross-env NODE_ENV=production node server/index.js",
    "preview": "vite preview",
    "db:setup": "node server/scripts/seed-db.mjs",
    "db:reset": "node server/scripts/seed-db.mjs --force",
    "db:migrate": "node server/scripts/migrate-all.mjs",
    "db:repair": "node server/scripts/repair-schema.mjs",
    "content:export": "node tools/_export_content.mjs",
    "content:sync": "node server/scripts/sync-content.mjs",
    "content:diff": "node server/scripts/sync-content.mjs --dry-run",
    "admin:reset": "node server/scripts/reset-admin.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.24.6",
    "three": "^0.186.1",
    "vue": "^3.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "playwright-core": "^1.64.1",
    "vite": "^5.4.0"
  }
}
