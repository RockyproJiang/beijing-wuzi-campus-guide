NODE_ENV=production

# 对外端口。要和服务器的防火墙 / 安全组放行的端口一致。
SERVE_PORT=5055

# 0.0.0.0 = 允许外网直接访问
# 127.0.0.1 = 只监听本机，必须配 Nginx 反代
HOST=127.0.0.1

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=bwz_campus_guide
DB_USER=bwz_app
DB_PASSWORD=change-me

# 必须换成你自己的随机串（至少 32 位）。生成：openssl rand -hex 48
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars
